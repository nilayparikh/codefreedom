{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "camoufox.schema.json",
  "title": "Camoufox Web Search Tool Profile",
  "description": "Schema for camoufox.json — configures the Camoufox container image, ports, data directory, and environment.",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Description of the profile"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Usage notes"
    },
    "camoufox": {
      "type": "object",
      "description": "Camoufox browser container settings",
      "properties": {
        "image": {
          "type": "string",
          "description": "Docker image tag (e.g. codefreedom:camoufox or docker.io/nilayparikh/codefreedom:camoufox-latest)"
        },
        "container_name": {
          "type": "string",
          "description": "Docker container name"
        },
        "port": {
          "type": "integer",
          "description": "Host port to map to container port 8420"
        },
        "data_dir": {
          "type": "string",
          "description": "Host data directory (mounted to /userdata)"
        },
        "env": {
          "type": "object",
          "description": "Extra environment variables"
        },
        "search_engines": {
          "type": "object",
          "description": "Map of search engine name to config. Each value is {url: string, parser: string}. Use {q} as the query placeholder in url. Example: {\"my-engine\": {\"url\": \"https://search.example.com/search?q={q}\", \"parser\": \"standard\"}}",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "description": "Search URL template with {q} placeholder"
              },
              "parser": {
                "type": "string",
                "description": "Parser name from the server's parser registry",
                "default": "standard"
              }
            },
            "required": [
              "url"
            ]
          }
        },
        "parser_registry": {
          "type": "object",
          "description": "Named parser configurations. Each parser defines CSS selectors for extracting search results from HTML. The 'standard' parser works with most modern search engines.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "result_selectors": {
                "type": "string",
                "description": "CSS selector for search result containers"
              },
              "link_selector": {
                "type": "string",
                "description": "CSS selector for the primary link within a result"
              },
              "snippet_selectors": {
                "type": "string",
                "description": "CSS selector for text snippets/descriptions"
              },
              "ai_selectors": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "CSS selectors for AI summary/answer blocks (tried in order)"
              }
            }
          }
        }
      }
    }
  }
}