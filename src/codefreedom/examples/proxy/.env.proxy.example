# ── .env.proxy.example ────────────────────────────────────────────────────────
# LiteLLM proxy configuration for CodeFreedom.
# This file is tracked in git — update it whenever you add or rename a variable.
#
# Copy to ~/.codefreedom/.env.proxy to activate:
#   codefreedom proxy init
#
# Configure: https://nilayparikh.github.io/codefreedom/proxy/
# ──────────────────────────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════════════════════════
# 1. Database
# ═══════════════════════════════════════════════════════════════════════════════

# ── No Database (default) ───────────────────────────────────────────────────
# The proxy runs stateless — no persistence, no Prisma, no Admin UI.
# Model routing and master-key auth work. Leave DATABASE_URL unset.
#
# ── PostgreSQL (opt-in) ─────────────────────────────────────────────────────
# To enable spend tracking, key management, and the Admin UI, uncomment BOTH:
#   DATABASE_URL=postgresql://litellm_interface:${LITELLM_DB_PASSWORD}@postgres:5432/litellm_interface
# Also update proxy/config/config.yaml:
#   - Uncomment: database_url: os.environ/DATABASE_URL
#   - Change: store_model_in_db: false → true
#   - Change: store_prompts_in_spend_logs: false → true


# ═══════════════════════════════════════════════════════════════════════════════
# 2. LiteLLM Proxy — core proxy settings
# ═══════════════════════════════════════════════════════════════════════════════

# ── Container ────────────────────────────────────────────────────────────────
# LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.87.0
# LITELLM_CONTAINER_NAME=litellm-codefreedom
# LITELLM_DATA_VOLUME=codefreedom-litellm-data

# ── Networking ───────────────────────────────────────────────────────────────
# LITELLM_PORT=4000
# LITELLM_BIND_HOST=0.0.0.0

# ── Observability ────────────────────────────────────────────────────────────
# LITELLM_LOG_LEVEL=INFO
# LITELLM_NO_DOCS="True"
# LITELLM_NO_REDOC="True"
# LITELLM_JSON_LOGS=true
# LITELLM_REQUIRE_AUTH_METRICS=false

# ── Privacy / Logging ────────────────────────────────────────────────────────
# LITELLM_DROP_PARAMS=true
# LITELLM_REDACT_USER_API_KEY=true
# LITELLM_TURN_OFF_MSG_LOGGING=false
# LITELLM_STREAM_USAGE=true

# ── Retry / Resilience ───────────────────────────────────────────────────────
# LITELLM_NUM_RETRIES=5
# LITELLM_RETRY_AFTER=0
# LITELLM_TIMEOUT_ERROR_RETRIES=5
# LITELLM_RATE_LIMIT_ERROR_RETRIES=5
# LITELLM_INTERNAL_ERROR_RETRIES=5


# ═══════════════════════════════════════════════════════════════════════════════
# 3. Model Aliases
# ═══════════════════════════════════════════════════════════════════════════════
# Model aliases map short CodeFreedom/ names to specific provider models.
# Claude Code discovers these aliases and presents them as available models.
#
# Each alias must match a model_name from provider YAML files
# (in proxy/config/providers/).
#
# Default: all point to DeepSeek cloud models.

# Ultra  — best reasoning, architecture, planning
# LITELLM_MODEL_ALIAS_ULTRA="DeepSeek/DeepSeek-V4-Pro"

# Pro    — implementation, coding work
# LITELLM_MODEL_ALIAS_PRO="DeepSeek/DeepSeek-V4-Flash"

# Flash  — fast, cheap tasks
# LITELLM_MODEL_ALIAS_FLASH="DeepSeek/DeepSeek-V4-Flash"

# Air    — lightweight scanning, mechanical tasks (optional)
# LITELLM_MODEL_ALIAS_AIR="DeepSeek/DeepSeek-V4-Flash"


# ═══════════════════════════════════════════════════════════════════════════════
# 4. Cloud Provider — Base URLs
# ═══════════════════════════════════════════════════════════════════════════════
# Set the matching API key in .env.proxy.secrets to enable a provider.
# Leave the key empty to disable.

# DEEPSEEK_BASE_URL=https://api.deepseek.com
# MICROSOFT_FOUNDRY_API_BASE=https://<space>.services.ai.azure.com/openai/v1
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1


# ═══════════════════════════════════════════════════════════════════════════════
# 5. OpenAI-Compatible Endpoint (bring your own model)
# ═══════════════════════════════════════════════════════════════════════════════
# OPENAI_COMPAT_BASE_URL=http://localhost:8000/v1
# OPENAI_COMPAT_MODEL=openai/your-model-name


# ═══════════════════════════════════════════════════════════════════════════════
# 6. Anthropic-Compatible Endpoint (bring your own model)
# ═══════════════════════════════════════════════════════════════════════════════
# ANTHROPIC_COMPAT_BASE_URL=http://localhost:8000
# ANTHROPIC_COMPAT_MODEL=claude-sonnet-4-20250514


# ═══════════════════════════════════════════════════════════════════════════════
# 7. Local Backends (pre-configured, two ports)
# ═══════════════════════════════════════════════════════════════════════════════
# LOCAL_M_BASE_URL=http://host.docker.internal:8000/v1
# LOCAL_S_BASE_URL=http://host.docker.internal:8001/v1
