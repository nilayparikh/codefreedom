# ── Claude Code Docker Image — CUDA (NVIDIA PyTorch) ──────────────────────────
# Platform: All NVIDIA GPUs — Blackwell, Hopper, Ada Lovelace, Ampere
# Architecture: Multi-arch (linux/arm64 + linux/amd64)
#   • DGX GB200/GH200 → native ARM64
#   • H100/A100/L40S/RTX → native AMD64
#
# @platform  CUDA
# @version   v0.1.0
# @arch      linux/arm64, linux/amd64
#
# Base: nvcr.io/nvidia/pytorch:26.04-py3 (multi-arch)
#   • Ubuntu 24.04, Python 3.12, CUDA 13.2.1, PyTorch 2.12, TensorRT 10.16
#
# Build:
#   docker build --build-arg IMAGE_VERSION=0.1.0 \
#     -t codefreedom:cuda-v0.1.0 \
#     -f docker/claude-code/Dockerfile.CUDA docker/claude-code/
# ────────────────────────────────────────────────────────────────────────────────

ARG IMAGE_VERSION=0.1.0

# 1. NVIDIA PyTorch — unified CUDA image for all NVIDIA GPUs (arm64 + amd64)
FROM nvcr.io/nvidia/pytorch:26.04-py3

ARG IMAGE_VERSION

LABEL org.opencontainers.image.title="CodeFreedom - Claude Code (CUDA / NVIDIA PyTorch)" \
      org.opencontainers.image.description="Claude Code with NVIDIA CUDA PyTorch — works on all NVIDIA GPUs (DGX, H100, A100, L40S, RTX)" \
      org.opencontainers.image.version="v${IMAGE_VERSION}" \
      org.opencontainers.image.vendor="nilayparikh" \
      org.opencontainers.image.authors="Nilay Parikh" \
      com.codefreedom.platform="CUDA" \
      com.codefreedom.arch="linux/arm64,linux/amd64"

ENV DEBIAN_FRONTEND=noninteractive

# 2. System packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    ca-certificates \
    shellcheck \
    fd-find \
    tree \
    ripgrep \
    jq \
    yq \
    zoxide \
    sd \
    unzip \
    bubblewrap \
    socat \
    openssh-client \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s $(which fdfind) /usr/local/bin/fd

# 3. Node.js LTS (v20)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# 4. GitHub CLI
RUN mkdir -p /usr/share/keyrings \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
    > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# 5. Productivity utilities — arch-aware (arm64 or amd64)
RUN set -eux; \
    ARCH=$(uname -m); \
    if [ "${ARCH}" = "aarch64" ]; then \
      AST_GREP_ARCH="aarch64-unknown-linux-gnu"; \
      DIFT_ARCH="aarch64-unknown-linux-gnu"; \
      SCC_ARCH="arm64"; \
      WATCHEXEC_ARCH="aarch64-unknown-linux-gnu"; \
    else \
      AST_GREP_ARCH="x86_64-unknown-linux-gnu"; \
      DIFT_ARCH="x86_64-unknown-linux-gnu"; \
      SCC_ARCH="x86_64"; \
      WATCHEXEC_ARCH="x86_64-unknown-linux-gnu"; \
    fi; \
    curl -fsSL -o /tmp/ast-grep.zip \
      "https://github.com/ast-grep/ast-grep/releases/latest/download/app-${AST_GREP_ARCH}.zip"; \
    unzip /tmp/ast-grep.zip -d /tmp/ast-grep; \
    install -Dm755 /tmp/ast-grep/ast-grep /usr/local/bin/ast-grep; \
    curl -fsSL -o /tmp/difft.tar.gz \
      "https://github.com/Wilfred/difftastic/releases/latest/download/difft-${DIFT_ARCH}.tar.gz"; \
    tar -xzf /tmp/difft.tar.gz -C /tmp; \
    install -Dm755 /tmp/difft /usr/local/bin/difft; \
    ln -fs /usr/local/bin/difft /usr/local/bin/difftastic; \
    curl -fsSL -o /tmp/scc.tar.gz \
      "https://github.com/boyter/scc/releases/latest/download/scc_Linux_${SCC_ARCH}.tar.gz"; \
    tar -xzf /tmp/scc.tar.gz -C /tmp; \
    install -Dm755 /tmp/scc /usr/local/bin/scc; \
    curl -fsSL -o /tmp/watchexec.deb \
      "https://github.com/watchexec/watchexec/releases/latest/download/watchexec-2.5.1-${WATCHEXEC_ARCH}.deb"; \
    apt-get update; \
    apt-get install -y --no-install-recommends /tmp/watchexec.deb; \
    rm -rf /tmp/* /var/lib/apt/lists/*

# 6. Claude Code
RUN npm install -g @anthropic-ai/claude-code \
    && npm config set cache /tmp/.npm --global \
    && npm cache clean --force

# 7. Language Server binaries — prerequisites for Claude Code code intelligence plugins
#     Activate each via: /plugin install <name>@claude-plugins-official
#     Supported: Python (pyright-lsp), TypeScript/JS (typescript-lsp),
#               Rust (rust-analyzer-lsp), C/C++ (clangd-lsp)
RUN set -eux; \
    # npm-based LSPs (architecture-independent)
    npm install -g \
        typescript-language-server \
        pyright; \
    # rust-analyzer — arch-aware binary
    ARCH=$(uname -m); \
    if [ "${ARCH}" = "aarch64" ]; then \
        RUST_URL="https://github.com/rust-lang/rust-analyzer/releases/latest/download/rust-analyzer-aarch64-unknown-linux-gnu.gz"; \
    else \
        RUST_URL="https://github.com/rust-lang/rust-analyzer/releases/latest/download/rust-analyzer-x86_64-unknown-linux-gnu.gz"; \
    fi; \
    curl -fsSL -o /tmp/rust-analyzer.gz "${RUST_URL}"; \
    gunzip -c /tmp/rust-analyzer.gz > /usr/local/bin/rust-analyzer; \
    chmod +x /usr/local/bin/rust-analyzer; \
    # clangd — C/C++ LSP (via apt, arch-independent)
    apt-get update; \
    apt-get install -y --no-install-recommends clangd; \
    rm -rf /tmp/* /var/lib/apt/lists/*

# 8. Trivy security scanner
RUN apt-get update && apt-get install -y --no-install-recommends wget gnupg \
    && wget -qO - https://aquasecurity.github.io/trivy-repo/deb/public.key | gpg --dearmor | tee /usr/share/keyrings/trivy.gpg > /dev/null \
    && echo "deb [signed-by=/usr/share/keyrings/trivy.gpg] https://aquasecurity.github.io/trivy-repo/deb generic main" > /etc/apt/sources.list.d/trivy.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends trivy \
    && rm -rf /var/lib/apt/lists/*

RUN trivy plugin install mcp

# 9. Non-root user — codefreedom (uid 1000) owns /workspace inside the container.
#    At runtime, the launcher may override this with --run-as-me to match the
#    host user's uid/gid for seamless file permission compatibility.
ARG USERNAME=codefreedom
ARG USER_UID=1000
ARG USER_GID=1000

RUN set -eux; \
    group_name="$(getent group "${USER_GID}" | cut -d: -f1 || true)"; \
    if [ -z "${group_name}" ]; then \
        group_name="${USERNAME}"; \
        groupadd --gid "${USER_GID}" "${group_name}"; \
    fi; \
    useradd --non-unique --uid "${USER_UID}" --gid "${group_name}" -m -s /bin/bash "${USERNAME}"; \
    apt-get update; \
    apt-get install -y --no-install-recommends sudo; \
    echo "${USERNAME} ALL=(root) NOPASSWD:ALL" > "/etc/sudoers.d/${USERNAME}"; \
    chmod 0440 "/etc/sudoers.d/${USERNAME}"; \
    mkdir -p /workspace; \
    chown "${USER_UID}:${USER_GID}" /workspace; \
    rm -rf /var/lib/apt/lists/*

# 10. Environment
ENV CLAUDE_CODE_ATTRIBUTION_HEADER="0" \
    IS_SANDBOX="1" \
    CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL="1" \
    CLAUDE_CODE_AUTO_CONNECT_IDE="false" \
    CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL="1" \
    DISABLE_INSTALLATION_CHECKS="1" \
    HOME="/home/${USERNAME}"

WORKDIR /workspace

# 11. Fix npm cache for any-user access — /tmp/.npm is world-writable so
#     npx/npm work when the container runs with a different UID at runtime.
RUN rm -rf /tmp/.npm && mkdir -p /tmp/.npm && chmod 1777 /tmp/.npm
