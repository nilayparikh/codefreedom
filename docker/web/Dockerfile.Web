# ── CodeFreedom Camoufox Browser Image (MCP-only) ───────────────────────
# Camoufox (Firefox fork) + Xvfb + PyAutoGUI + MCP server for reliable
# web automation and data access via standard browser APIs.
#
# Two input modes:
#   • Playwright (DOM-level) — CSS selectors, fast & convenient
#   • PyAutoGUI (OS-level)  — mouse/keyboard events for complex interactions
#
# Port:
#   8420 — MCP Streamable HTTP server (web_search + web_fetch tools)
#
# Design highlights:
#   • Camoufox = Firefox fork without Chrome DevTools Protocol (CDP),
#     meaning the browser presents a standard Firefox profile to websites
#   • Xvfb at 1920x1080x24 — headed mode with a real display buffer
#   • PyAutoGUI — OS-level input emulation for interactive workflows
#   • browserforge — generates consistent browser profiles
#   • Persistent profile stored in /userdata for session continuity
#
# @platform  Ubuntu
# @version   v0.2.0
# @arch      linux/arm64, linux/amd64
#
# Build:
#   docker build \
#     -t codefreedom:Camoufox-local \
#     -f docker/web/Dockerfile.Camoufox docker/web/
#
# Run:
#   docker run -d --name codefreedom-camoufox \
#     -p 8420:8420 \
#     -p 5900:5900 \
#     -v ~/.codefreedom/sandbox/tools/camoufox:/userdata \
#     codefreedom:Camoufox-local
#
# ──────────────────────────────────────────────────────────────────────────

ARG IMAGE_VERSION=0.2.0

FROM python:3.13-slim

ARG IMAGE_VERSION

LABEL org.opencontainers.image.title="CodeFreedom - Camoufox Browser (MCP)" \
      org.opencontainers.image.description="Web automation with Camoufox (Firefox fork) + Xvfb + PyAutoGUI + MCP server for reliable browser-based data access." \
      org.opencontainers.image.version="v${IMAGE_VERSION}" \
      org.opencontainers.image.vendor="nilayparikh" \
      org.opencontainers.image.authors="Nilay Parikh" \
      com.codefreedom.platform="Camoufox" \
      com.codefreedom.arch="linux/arm64,linux/amd64"

# Patch known vulnerabilities in base image
# `dist-upgrade` (vs `upgrade`) lets apt handle dependency changes that some
# security patches introduce. The same upgrade is repeated after the
# additional package installs below so that packages added in later layers
# also receive the latest security patches from the refreshed apt index.
RUN apt-get update && apt-get -y dist-upgrade && rm -rf /var/lib/apt/lists/*

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Timezone - override with -e TZ=Your/Timezone
ENV TZ=UTC

# Install tzdata for proper timezone support
RUN apt-get update && apt-get install -y --no-install-recommends \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Base utils
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget curl gnupg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# X11 and display
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb xauth dbus dbus-x11 x11-xserver-utils xcvt \
    && rm -rf /var/lib/apt/lists/*

# VNC intentionally excluded — MCP-only mode, no VNC viewer needed

# Window manager (title bars + resize handles for popup windows)
RUN apt-get update && apt-get install -y --no-install-recommends \
    openbox \
    && rm -rf /var/lib/apt/lists/*

# Create /tmp/.X11-unix to suppress X11 socket permission warning
RUN mkdir -p /tmp/.X11-unix && chmod 1777 /tmp/.X11-unix

# Create minimal Openbox menu to suppress menu file warning
RUN mkdir -p /var/lib/openbox && echo '<?xml version="1.0" encoding="UTF-8"?><openbox_menu></openbox_menu>' > /var/lib/openbox/debian-menu.xml

# noVNC auto-connect redirect — removed, MCP-only mode

# Firefox/Camoufox dependencies - install firefox-esr to pull correct GTK deps
RUN apt-get update \
    && apt-get install -y --no-install-recommends firefox-esr fonts-liberation \
    && apt-get remove -y --purge firefox-esr \
    && rm -rf /var/lib/apt/lists/*

# UI automation tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    xdotool scrot python3-tk python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages (system-level, needs root)
RUN pip install --no-cache-dir "camoufox[geoip]" pyautogui fastapi uvicorn fastmcp Pillow pyyaml beautifulsoup4 requests

# Create non-root user and directories
RUN groupadd -g 1000 codefreedom && useradd -u 1000 -g 1000 -m codefreedom
RUN mkdir -p /app /userdata && chown -R codefreedom:codefreedom /app /userdata

# Allow codefreedom user to write GeoIP db into camoufox package dir
# Use Python to find the actual path (avoids hardcoding Python version)
RUN CAMOUFOX_DIR=$(python -c "import camoufox; print(camoufox.__path__[0])") && \
    chown -R codefreedom:codefreedom "$CAMOUFOX_DIR"

# Switch to non-root user for camoufox fetch + extensions
USER codefreedom

# Download Camoufox browser (writes to ~/.cache/camoufox + GeoIP db)
RUN python -m camoufox fetch

# Copy app code
COPY --chown=codefreedom:codefreedom app/ /app/

# Install browser extensions (writes to ~/.cache/camoufox)
RUN python /app/install_extensions.py

# Set working directory
WORKDIR /app

# Install gosu for privilege dropping in entrypoint
# Re-run dist-upgrade after every other apt install so security patches
# that landed since the first upgrade are applied to packages we just
# installed (tzdata, x11, openbox, firefox-esr deps, xdotool, etc.).
USER root
RUN apt-get update \
    && apt-get -y dist-upgrade \
    && apt-get install -y --no-install-recommends gosu \
    && rm -rf /var/lib/apt/lists/*

# Copy entrypoint (runs as root, drops to target user)
COPY --chmod=755 entrypoint.sh /entrypoint.sh

# Environment variables
ENV XVFB_RESOLUTION=1920x1080
ENV XVFB_DEPTH=24

# Expose ports (VNC and HTTP API + MCP)
EXPOSE 5900 8420

ENTRYPOINT ["/entrypoint.sh"]
