# ── CodeFreedom — Docker Agents Image ─────────────────────────────────────────
# Contains all 3 coding agent CLIs (claude, mimo, opencode).
# Build targets: ubuntu (CPU), cuda (NVIDIA GPU), rocm (AMD GPU)
#
# @version   v1.0.0
# @arch      linux/arm64, linux/amd64 (ubuntu, cuda), linux/amd64 (rocm)
#
# Build:
#   docker build --target ubuntu -t codefreedom:ubuntu-v1.0.0 \
#     -f docker/agents/Dockerfile.Agents docker/agents/
#   docker build --target cuda -t codefreedom:cuda-v1.0.0 \
#     -f docker/agents/Dockerfile.Agents docker/agents/
#   docker build --target rocm -t codefreedom:rocm-v1.0.0 \
#     -f docker/agents/Dockerfile.Agents docker/agents/
# ────────────────────────────────────────────────────────────────────────────────

ARG IMAGE_VERSION=1.0.0
ARG ROCM_PLATFORM=linux/amd64

# ════════════════════════════════════════════════════════════════════════════════
# Stage 1: Toolchain — shared across all platforms
# Installs common packages, Node.js, GitHub CLI, productivity utils,
# language servers, Trivy, and all 3 agent CLIs (claude, mimo, opencode).
# ════════════════════════════════════════════════════════════════════════════════
FROM ubuntu:24.04 AS toolchain

ENV DEBIAN_FRONTEND=noninteractive

# 1. System packages (superset of all 3 agent requirements)
RUN apt-get update \
    && apt-get -y dist-upgrade \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
        curl \
        git \
        ca-certificates \
        shellcheck \
        fd-find \
        tree \
        ripgrep \
        jq \
        yq \
        zoxide \
        sd \
        unzip \
        bubblewrap \
        socat \
        openssh-client \
        libgcc-s1 \
        libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s $(which fdfind) /usr/local/bin/fd \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3 1 \
    && update-alternatives --install /usr/bin/pip pip /usr/bin/pip3 1

# 2. Node.js LTS (v20)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# 3. GitHub CLI
RUN mkdir -p /usr/share/keyrings \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
    > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# 4. Productivity utilities — arch-aware (arm64 or amd64)
RUN set -eux; \
    ARCH=$(uname -m); \
    if [ "${ARCH}" = "aarch64" ]; then \
      AST_GREP_ARCH="aarch64-unknown-linux-gnu"; \
      DIFT_ARCH="aarch64-unknown-linux-gnu"; \
      SCC_ARCH="arm64"; \
      WATCHEXEC_ARCH="aarch64-unknown-linux-gnu"; \
    else \
      AST_GREP_ARCH="x86_64-unknown-linux-gnu"; \
      DIFT_ARCH="x86_64-unknown-linux-gnu"; \
      SCC_ARCH="x86_64"; \
      WATCHEXEC_ARCH="x86_64-unknown-linux-gnu"; \
    fi; \
    curl -fsSL -o /tmp/ast-grep.zip \
      "https://github.com/ast-grep/ast-grep/releases/latest/download/app-${AST_GREP_ARCH}.zip"; \
    unzip /tmp/ast-grep.zip -d /tmp/ast-grep; \
    install -Dm755 /tmp/ast-grep/ast-grep /usr/local/bin/ast-grep; \
    curl -fsSL -o /tmp/difft.tar.gz \
      "https://github.com/Wilfred/difftastic/releases/latest/download/difft-${DIFT_ARCH}.tar.gz"; \
    tar -xzf /tmp/difft.tar.gz -C /tmp; \
    install -Dm755 /tmp/difft /usr/local/bin/difft; \
    ln -fs /usr/local/bin/difft /usr/local/bin/difftastic; \
    curl -fsSL -o /tmp/scc.tar.gz \
      "https://github.com/boyter/scc/releases/latest/download/scc_Linux_${SCC_ARCH}.tar.gz"; \
    tar -xzf /tmp/scc.tar.gz -C /tmp; \
    install -Dm755 /tmp/scc /usr/local/bin/scc; \
    curl -fsSL -o /tmp/watchexec.deb \
      "https://github.com/watchexec/watchexec/releases/latest/download/watchexec-2.5.1-${WATCHEXEC_ARCH}.deb"; \
    apt-get update; \
    apt-get install -y --no-install-recommends /tmp/watchexec.deb; \
    rm -rf /tmp/* /var/lib/apt/lists/*

# 5. Language Server binaries
RUN set -eux; \
    npm install -g \
        typescript-language-server \
        pyright; \
    ARCH=$(uname -m); \
    if [ "${ARCH}" = "aarch64" ]; then \
        RUST_URL="https://github.com/rust-lang/rust-analyzer/releases/latest/download/rust-analyzer-aarch64-unknown-linux-gnu.gz"; \
    else \
        RUST_URL="https://github.com/rust-lang/rust-analyzer/releases/latest/download/rust-analyzer-x86_64-unknown-linux-gnu.gz"; \
    fi; \
    curl -fsSL -o /tmp/rust-analyzer.gz "${RUST_URL}"; \
    gunzip -c /tmp/rust-analyzer.gz > /usr/local/bin/rust-analyzer; \
    chmod +x /usr/local/bin/rust-analyzer; \
    apt-get update; \
    apt-get install -y --no-install-recommends clangd; \
    rm -rf /tmp/* /var/lib/apt/lists/*

# 6. Trivy security scanner
RUN apt-get update && apt-get install -y --no-install-recommends wget gnupg \
    && wget -qO - https://aquasecurity.github.io/trivy-repo/deb/public.key | gpg --dearmor | tee /usr/share/keyrings/trivy.gpg > /dev/null \
    && echo "deb [signed-by=/usr/share/keyrings/trivy.gpg] https://aquasecurity.github.io/trivy-repo/deb generic main" > /etc/apt/sources.list.d/trivy.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends trivy \
    && rm -rf /var/lib/apt/lists/*

RUN trivy plugin install mcp

# 7. Claude Code
RUN npm install -g @anthropic-ai/claude-code \
    && npm config set cache /tmp/.npm --global \
    && npm cache clean --force

# 8. MiMoCode — install via npm and pre-download native binary
RUN npm install -g @mimo-ai/cli \
    && mimo --version 2>/dev/null || true \
    && rm -rf /tmp/*

# 9. OpenCode — install via official install script
RUN curl -fsSL https://opencode.ai/install | bash \
    && cp /root/.opencode/bin/opencode /usr/local/bin/opencode \
    && chmod 755 /usr/local/bin/opencode \
    && rm -rf /tmp/*


# ════════════════════════════════════════════════════════════════════════════════
# Stage 2: Ubuntu (CPU-only) — all architectures
# ════════════════════════════════════════════════════════════════════════════════
FROM ubuntu:24.04 AS ubuntu

ARG IMAGE_VERSION

LABEL org.opencontainers.image.title="CodeFreedom - Ubuntu" \
      org.opencontainers.image.description="CodeFreedom dev container — all coding agents (claude, mimo, opencode) with dev tools. CPU-only." \
      org.opencontainers.image.version="v${IMAGE_VERSION}" \
      org.opencontainers.image.vendor="nilayparikh" \
      org.opencontainers.image.authors="Nilay Parikh" \
      com.codefreedom.platform="Ubuntu" \
      com.codefreedom.arch="linux/arm64,linux/amd64"

ENV DEBIAN_FRONTEND=noninteractive

COPY --from=toolchain /usr/local/bin/ /usr/local/bin/
COPY --from=toolchain /usr/lib/node_modules/ /usr/lib/node_modules/
COPY --from=toolchain /usr/bin/node /usr/bin/node
COPY --from=toolchain /usr/bin/npm /usr/bin/npm
COPY --from=toolchain /usr/bin/npx /usr/bin/npx
COPY --from=toolchain /usr/local/share/ /usr/local/share/
COPY --from=toolchain /usr/share/keyrings/ /usr/share/keyrings/
COPY --from=toolchain /etc/apt/sources.list.d/ /etc/apt/sources.list.d/
COPY --from=toolchain /usr/bin/gh /usr/bin/gh
COPY --from=toolchain /root/.opencode/ /root/.opencode/
COPY --from=toolchain /usr/local/lib/node_modules/@mimo-ai/ /usr/local/lib/node_modules/@mimo-ai/

RUN apt-get update \
    && apt-get -y dist-upgrade \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
        curl \
        git \
        ca-certificates \
        shellcheck \
        fd-find \
        tree \
        ripgrep \
        jq \
        yq \
        zoxide \
        sd \
        unzip \
        bubblewrap \
        socat \
        openssh-client \
        libgcc-s1 \
        libstdc++6 \
        sudo \
        clangd \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf $(which fdfind) /usr/local/bin/fd \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3 1 \
    && update-alternatives --install /usr/bin/pip pip /usr/bin/pip3 1

ARG USERNAME=codefreedom
ARG USER_UID=1000
ARG USER_GID=1000

RUN set -eux; \
    group_name="$(getent group "${USER_GID}" | cut -d: -f1 || true)"; \
    if [ -z "${group_name}" ]; then \
        group_name="${USERNAME}"; \
        groupadd --gid "${USER_GID}" "${group_name}"; \
    fi; \
    useradd --non-unique --uid "${USER_UID}" --gid "${group_name}" -m -s /bin/bash "${USERNAME}"; \
    echo "${USERNAME} ALL=(root) NOPASSWD:ALL" > "/etc/sudoers.d/${USERNAME}"; \
    chmod 0440 "/etc/sudoers.d/${USERNAME}"; \
    mkdir -p /workspace; \
    chown "${USER_UID}:${USER_GID}" /workspace

ENV IS_SANDBOX="1" \
    CLAUDE_CODE_ATTRIBUTION_HEADER="0" \
    CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL="1" \
    CLAUDE_CODE_AUTO_CONNECT_IDE="false" \
    CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL="1" \
    DISABLE_INSTALLATION_CHECKS="1" \
    MIMOCODE_DISABLE_AUTOUPDATE="1" \
    MIMOCODE_DISABLE_MODELS_FETCH="1" \
    OPENCODE_DISABLE_AUTOUPDATE="1" \
    HOME="/home/${USERNAME}"

WORKDIR /workspace

RUN rm -rf /tmp/.npm && mkdir -p /tmp/.npm && chmod 1777 /tmp/.npm


# ════════════════════════════════════════════════════════════════════════════════
# Stage 3: CUDA (NVIDIA GPUs) — all architectures
# Base: nvcr.io/nvidia/pytorch:26.04-py3
#   Ubuntu 24.04, Python 3.12, CUDA 13.2.1, PyTorch 2.12, TensorRT 10.16
# ════════════════════════════════════════════════════════════════════════════════
FROM nvcr.io/nvidia/pytorch:26.04-py3 AS cuda

ARG IMAGE_VERSION

LABEL org.opencontainers.image.title="CodeFreedom - CUDA" \
      org.opencontainers.image.description="CodeFreedom dev container — all coding agents (claude, mimo, opencode) with NVIDIA CUDA PyTorch." \
      org.opencontainers.image.version="v${IMAGE_VERSION}" \
      org.opencontainers.image.vendor="nilayparikh" \
      org.opencontainers.image.authors="Nilay Parikh" \
      com.codefreedom.platform="CUDA" \
      com.codefreedom.arch="linux/arm64,linux/amd64"

ENV DEBIAN_FRONTEND=noninteractive

COPY --from=toolchain /usr/local/bin/ /usr/local/bin/
COPY --from=toolchain /usr/lib/node_modules/ /usr/lib/node_modules/
COPY --from=toolchain /usr/bin/node /usr/bin/node
COPY --from=toolchain /usr/bin/npm /usr/bin/npm
COPY --from=toolchain /usr/bin/npx /usr/bin/npx
COPY --from=toolchain /usr/local/share/ /usr/local/share/
COPY --from=toolchain /usr/share/keyrings/ /usr/share/keyrings/
COPY --from=toolchain /etc/apt/sources.list.d/ /etc/apt/sources.list.d/
COPY --from=toolchain /usr/bin/gh /usr/bin/gh
COPY --from=toolchain /root/.opencode/ /root/.opencode/
COPY --from=toolchain /usr/local/lib/node_modules/@mimo-ai/ /usr/local/lib/node_modules/@mimo-ai/

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        git \
        ca-certificates \
        shellcheck \
        fd-find \
        tree \
        ripgrep \
        jq \
        yq \
        zoxide \
        sd \
        unzip \
        bubblewrap \
        socat \
        openssh-client \
        sudo \
        clangd \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf $(which fdfind) /usr/local/bin/fd

ARG USERNAME=codefreedom
ARG USER_UID=1000
ARG USER_GID=1000

RUN set -eux; \
    group_name="$(getent group "${USER_GID}" | cut -d: -f1 || true)"; \
    if [ -z "${group_name}" ]; then \
        group_name="${USERNAME}"; \
        groupadd --gid "${USER_GID}" "${group_name}"; \
    fi; \
    useradd --non-unique --uid "${USER_UID}" --gid "${group_name}" -m -s /bin/bash "${USERNAME}"; \
    echo "${USERNAME} ALL=(root) NOPASSWD:ALL" > "/etc/sudoers.d/${USERNAME}"; \
    chmod 0440 "/etc/sudoers.d/${USERNAME}"; \
    mkdir -p /workspace; \
    chown "${USER_UID}:${USER_GID}" /workspace

ENV IS_SANDBOX="1" \
    CLAUDE_CODE_ATTRIBUTION_HEADER="0" \
    CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL="1" \
    CLAUDE_CODE_AUTO_CONNECT_IDE="false" \
    CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL="1" \
    DISABLE_INSTALLATION_CHECKS="1" \
    MIMOCODE_DISABLE_AUTOUPDATE="1" \
    MIMOCODE_DISABLE_MODELS_FETCH="1" \
    OPENCODE_DISABLE_AUTOUPDATE="1" \
    HOME="/home/${USERNAME}"

WORKDIR /workspace

RUN rm -rf /tmp/.npm && mkdir -p /tmp/.npm && chmod 1777 /tmp/.npm


# ════════════════════════════════════════════════════════════════════════════════
# Stage 4: ROCm (AMD GPUs) — linux/amd64 only
# Base: rocm/pytorch:rocm7.2.4_ubuntu24.04_py3.12_pytorch_release_2.10.0
#   Ubuntu 24.04, Python 3.12, PyTorch 2.10, ROCm 7.2.4
# ════════════════════════════════════════════════════════════════════════════════
FROM --platform=$ROCM_PLATFORM rocm/pytorch:rocm7.2.4_ubuntu24.04_py3.12_pytorch_release_2.10.0 AS rocm

ARG IMAGE_VERSION

LABEL org.opencontainers.image.title="CodeFreedom - ROCm" \
      org.opencontainers.image.description="CodeFreedom dev container — all coding agents (claude, mimo, opencode) with AMD ROCm PyTorch." \
      org.opencontainers.image.version="v${IMAGE_VERSION}" \
      org.opencontainers.image.vendor="nilayparikh" \
      org.opencontainers.image.authors="Nilay Parikh" \
      com.codefreedom.platform="ROCm" \
      com.codefreedom.arch="linux/amd64"

ENV DEBIAN_FRONTEND=noninteractive

COPY --from=toolchain /usr/local/bin/ /usr/local/bin/
COPY --from=toolchain /usr/lib/node_modules/ /usr/lib/node_modules/
COPY --from=toolchain /usr/bin/node /usr/bin/node
COPY --from=toolchain /usr/bin/npm /usr/bin/npm
COPY --from=toolchain /usr/bin/npx /usr/bin/npx
COPY --from=toolchain /usr/local/share/ /usr/local/share/
COPY --from=toolchain /usr/share/keyrings/ /usr/share/keyrings/
COPY --from=toolchain /etc/apt/sources.list.d/ /etc/apt/sources.list.d/
COPY --from=toolchain /usr/bin/gh /usr/bin/gh
COPY --from=toolchain /root/.opencode/ /root/.opencode/
COPY --from=toolchain /usr/local/lib/node_modules/@mimo-ai/ /usr/local/lib/node_modules/@mimo-ai/

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        git \
        ca-certificates \
        shellcheck \
        fd-find \
        tree \
        ripgrep \
        jq \
        yq \
        zoxide \
        sd \
        unzip \
        bubblewrap \
        socat \
        openssh-client \
        sudo \
        clangd \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf $(which fdfind) /usr/local/bin/fd

ARG USERNAME=codefreedom
ARG USER_UID=1000
ARG USER_GID=1000

RUN set -eux; \
    group_name="$(getent group "${USER_GID}" | cut -d: -f1 || true)"; \
    if [ -z "${group_name}" ]; then \
        group_name="${USERNAME}"; \
        groupadd --gid "${USER_GID}" "${group_name}"; \
    fi; \
    useradd --non-unique --uid "${USER_UID}" --gid "${group_name}" -m -s /bin/bash "${USERNAME}"; \
    echo "${USERNAME} ALL=(root) NOPASSWD:ALL" > "/etc/sudoers.d/${USERNAME}"; \
    chmod 0440 "/etc/sudoers.d/${USERNAME}"; \
    mkdir -p /workspace; \
    chown "${USER_UID}:${USER_GID}" /workspace

ENV IS_SANDBOX="1" \
    CLAUDE_CODE_ATTRIBUTION_HEADER="0" \
    CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL="1" \
    CLAUDE_CODE_AUTO_CONNECT_IDE="false" \
    CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL="1" \
    DISABLE_INSTALLATION_CHECKS="1" \
    MIMOCODE_DISABLE_AUTOUPDATE="1" \
    MIMOCODE_DISABLE_MODELS_FETCH="1" \
    OPENCODE_DISABLE_AUTOUPDATE="1" \
    HOME="/home/${USERNAME}"

WORKDIR /workspace

RUN rm -rf /tmp/.npm && mkdir -p /tmp/.npm && chmod 1777 /tmp/.npm
