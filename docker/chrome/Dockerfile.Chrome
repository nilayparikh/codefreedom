# ── CodeFreedom Chrome Browser Image (Headless + MCP) ──────────────────
# Self-contained Chrome tool for codefreedom — provides both:
#   • CDP debug port (9222) for direct Chrome DevTools / Puppeteer
#   • HTTP MCP server (9223) for Claude Code / coding agents
#
# The container runs two processes supervised by dumb-init (PID 1):
#   1. headless Chrome  --remote-debugging-port=9222
#   2. mcp-proxy        --port=9223 -> chrome-devtools-mcp (stdio MCP)
#
# The MCP endpoint is fully self-contained: no `npx` invocation needed
# from the calling agent.  Just point Claude Code at
#   http://127.0.0.1:9223/mcp
# and the chrome-devtools-mcp toolset (navigate, click, screenshot,
# console, performance traces, etc.) is available.
#
# Design:
#   • Headless mode (--headless=new) — required for multiple CDP targets
#     (chrome-devtools-mcp creates DevTools sessions that classic headless mode rejects)
#   • Retail Google Chrome Stable (amd64) / Chromium snapshot (arm64)
#   • --remote-allow-origins=* required for non-localhost CDP clients
#     (Chrome 128+ enforces an origin allowlist by default)
#   • Node.js LTS + chrome-devtools-mcp + mcp-proxy (npm) for the
#     streamable-HTTP MCP bridge
#   • dumb-init as PID 1 — clean signal forwarding to both processes
#   • Healthcheck via CDP /json/version endpoint
#   • Minimal attack surface — no DBus, no PulseAudio, no X11, no sudo
#
# For anti-bot / stealth / headed browsing, use the 'web' tool
# (docker/web — Camoufox MCP server) instead. Chrome here is a plain
# automation target: simple, fast, and quiet.
#
# @platform  Ubuntu
# @version   v0.3.0
# @arch      linux/amd64 (Google Chrome), linux/arm64 (Chromium snapshots)
#
# Base: ubuntu:24.04 LTS (multi-arch)
#
# Build:
#   docker build --build-arg IMAGE_VERSION=0.3.0 \
#     -t codefreedom:chrome-v0.3.0 \
#     -f docker/chrome/Dockerfile.Chrome docker/chrome/
#
# Run:
#   docker run -d --name codefreedom-chrome \
#     -p 9222:9222 \
#     -p 9223:9223 \
#     --shm-size=512m \
#     -v ~/.codefreedom/sandbox/tools/chrome:/data/chrome \
#     codefreedom:chrome-latest
#
# CDP connect:  devtools://devtools/bundled/inspector.html?ws=127.0.0.1:9222
# MCP connect:  http://127.0.0.1:9223/mcp
# ────────────────────────────────────────────────────────────────────────────────

ARG IMAGE_VERSION=0.3.0

# 1. Ubuntu 24.04 LTS (multi-arch: arm64 + amd64)
FROM ubuntu:24.04

ARG IMAGE_VERSION

LABEL org.opencontainers.image.title="CodeFreedom - Chrome Browser (Headless + MCP)" \
      org.opencontainers.image.description="Self-contained Chrome tool: headless browser on CDP 9222 + MCP server on 9223. Use the 'web' tool (Camoufox) for stealth / anti-bot browsing." \
      org.opencontainers.image.version="v${IMAGE_VERSION}" \
      org.opencontainers.image.vendor="nilayparikh" \
      org.opencontainers.image.authors="Nilay Parikh" \
      com.codefreedom.platform="Chrome" \
      com.codefreedom.arch="linux/arm64,linux/amd64"

ENV DEBIAN_FRONTEND=noninteractive

# Patch known vulnerabilities in base image
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

# 2. Minimal runtime deps for headless Chrome:
#     dumb-init (PID 1), curl (healthcheck), python3 (arm64 chromium
#     revision parser), shared libs Chrome needs.
#     We deliberately do NOT install: xvfb, pulseaudio, dbus, fontconfig,
#     font packages, sudo, or any desktop components. Headless mode
#     needs none of them, and they all add log noise on boot.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    dumb-init \
    gnupg \
    libnss3 \
    libatk1.0-0t64 \
    libatk-bridge2.0-0t64 \
    libcups2t64 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2t64 \
    python3 \
    socat \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# 2.5 Node.js LTS (v20) — required by chrome-devtools-mcp + mcp-proxy
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# 2.6 MCP packages — chrome-devtools-mcp (CDP ↔ MCP adapter) +
#     mcp-proxy (stdio → HTTP bridge)
RUN npm install -g \
      "chrome-devtools-mcp@1.1.1" \
      mcp-proxy \
    && npm cache clean --force

# 3. Browser binary — architecture-aware
#     amd64 → Google Chrome stable from Google repo (retail build)
#     arm64 → Chromium from Playwright CDN (Ubuntu's chromium-browser is a snap
#             shim on 24.04 that breaks in Docker)
RUN set -eux; \
    ARCH=$(uname -m); \
    if [ "${ARCH}" = "aarch64" ]; then \
        CHROMIUM_REV=$(curl -fsSL "https://raw.githubusercontent.com/microsoft/playwright/main/packages/playwright-core/browsers.json" \
          | python3 -c "import sys,json; print([b['revision'] for b in json.load(sys.stdin)['browsers'] if b['name']=='chromium'][0])"); \
        curl -fsSL "https://playwright.azureedge.net/builds/chromium/${CHROMIUM_REV}/chromium-linux-arm64.zip" -o /tmp/chrome.zip; \
        mkdir -p /opt/chrome; \
        unzip /tmp/chrome.zip -d /opt/chrome; \
        ln -sf $(find /opt/chrome -name 'chrome' -type f | head -1) /usr/local/bin/chrome; \
        rm -rf /tmp/chrome.zip; \
    else \
        curl -fsSL https://dl-ssl.google.com/linux/linux_signing_key.pub \
          | gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg; \
        echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] http://dl.google.com/linux/chrome/deb/ stable main" \
          > /etc/apt/sources.list.d/google-chrome.list; \
        apt-get update; \
        apt-get install -y --no-install-recommends google-chrome-stable; \
        rm -rf /var/lib/apt/lists/*; \
        ln -sf /usr/bin/google-chrome-stable /usr/local/bin/chrome; \
    fi

# 4. Chrome wrapper — launches Chrome in headless mode with quiet flags.
#     In headless mode we DO want --no-sandbox (we run as a non-root
#     codefreedom user) and --disable-gpu (no display server).
#     stderr is filtered to drop noisy, harmless warnings (xkbcomp,
#     GCM, Vulkan) so the container log stays clean.
#     Stale SingletonLock / SingletonCookie / SingletonSocket symlinks
#     are removed on startup so a previous container's lock cannot
#     prevent this container from launching (common when a container
#     is killed ungracefully).
RUN printf '#!/bin/bash\n\
set -e\n\
\n\
CHROME_DATA="${CHROME_DATA_DIR:-/data/chrome}"\n\
mkdir -p "${CHROME_DATA}"\n\
\n\
# Remove stale Chromium singleton locks. These point to dead host:pid\n\
# tuples from previous container runs and would otherwise cause Chrome\n\
# to refuse to start with "profile appears to be in use".\n\
rm -f "${CHROME_DATA}/SingletonLock" \\\n\
      "${CHROME_DATA}/SingletonCookie" \\\n\
      "${CHROME_DATA}/SingletonSocket"\n\
\n\
exec /usr/local/bin/chrome \\\n\
  --headless=new \\\n\
  --no-sandbox \\\n\
  --disable-gpu \\\n\
  --disable-dev-shm-usage \\\n\
  --remote-debugging-address=0.0.0.0 \\\n\
  --remote-debugging-port="${CHROME_DEBUG_PORT:-9222}" \\\n  --remote-allow-origins="*" \\\n  --user-data-dir="${CHROME_DATA}" \\\n\
  --no-first-run \\\n\
  --no-default-browser-check \\\n\
  --disable-sync \\\n\
  --disable-background-networking \\\n\
  --disable-crash-reporter \\\n\
  --disable-component-update \\\n\
  --disable-features=Translate,IsolateOrigins,site-per-process,PushMessaging,MediaRouter,InterestFeedContentSuggestions,CalculateNativeWinOcclusion,OptimizationHints,AudioServiceOutOfProcess,UseEcoQoSForBackgroundProcess,InProductHelpSnooze,DCFVariationsSafeMode,EnableMediaFoundationVideoCapture,UseChromeOSDirectVideoDecoder,WebOTPCrossDevice,PrivacySandboxAdsAPIsOverride,VizDisplayCompositor,WebPayments,WebUsb,SmartCard,NotificationTriggers \\\n\
  --password-store=basic \\\n\
  --use-mock-keychain \\\n\
  --lang=en-US \\\n\
  --mute-audio \\\n\
  --hide-scrollbars \\\n\
  --window-size=1920,1080 \\\n\
  --enable-logging=stderr \\\n\
  --v=0 \\\n\
  "$@" 2> >(grep --line-buffered -v -E "xkbcomp|GCM|registration_request|DEPRECATED_ENDPOINT|Vulkan|dawn|swiftshader|webgl|VK_ERROR|GLImplementationParts|gpu_init|FontConfigError|GetVSOCKInstance|Failed to connect to the bus|gpu_data_manager|GroupMarkNotSet|process_singleton|message_box_dialog|profile appears to be in use|audio_manager_linux|vaapi_wrapper|drmGetDevices2|sandbox/policy/linux|account_consistency_mode_manager|GLib-GIO|dbus/object_proxy|bluez_dbus_manager|dbus/property|UPower|idle_linux|vkCreateInstance|eglChooseConfig|Falling back to ALSA|Floss manager|PropertiesChanged|Properties.GetAll|NameHasOwner|BackendType|discover a" || true)\n\
' > /usr/local/bin/chrome-wrapper \
    && chmod +x /usr/local/bin/chrome-wrapper

# 5. Healthcheck — verifies Chrome CDP endpoint is responding
RUN printf '#!/bin/sh\n\
curl -sf http://127.0.0.1:${CHROME_DEBUG_PORT:-9222}/json/version > /dev/null 2>&1\n\
' > /usr/local/bin/chrome-healthcheck && chmod +x /usr/local/bin/chrome-healthcheck

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD /usr/local/bin/chrome-healthcheck

# 6. Non-root user — codefreedom (uid 1000). Chrome runs as a non-root
#    user for defence in depth. The --no-sandbox flag is still needed
#    because Chrome requires kernel sandboxing features unavailable in
#    Docker, but the browser process itself runs as codefreedom.
ARG USERNAME=codefreedom
ARG USER_UID=1000
ARG USER_GID=1000

RUN set -eux; \
    group_name="$(getent group "${USER_GID}" | cut -d: -f1 || true)"; \
    if [ -z "${group_name}" ]; then \
        group_name="${USERNAME}"; \
        groupadd --gid "${USER_GID}" "${group_name}"; \
    fi; \
    useradd --non-unique --uid "${USER_UID}" --gid "${group_name}" -m -s /bin/bash "${USERNAME}"; \
    mkdir -p /data && chown "${USER_UID}:${USER_GID}" /data

# 7. Environment
ENV CHROME_DEBUG_PORT=9222 \
    MCP_PORT=9223 \
    MCP_PATH=/mcp \
    CHROME_DATA_DIR=/data/chrome

# 8. Ports — CDP (9222) + MCP (9223)
EXPOSE 9222 9223

# 9. Volumes
VOLUME ["/data/chrome"]

# 10. Copy entrypoint (supervises Chrome + mcp-proxy)
COPY --chmod=755 entrypoint.sh /usr/local/bin/entrypoint.sh

# 11. Switch to non-root user
USER codefreedom

# 12. Default command
WORKDIR /data
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
