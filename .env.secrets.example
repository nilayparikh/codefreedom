# ── .env.secrets.example ──────────────────────────────────────────────────────
# Template for secrets. Copy to .env.secrets and fill in your actual values.
#
#   cp .env.secrets.example .env.secrets
#
# NEVER commit .env.secrets to git. It is already in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════════════════════════
# LiteLLM Proxy Master Key
# ═══════════════════════════════════════════════════════════════════════════════
# Used to authenticate requests to the LiteLLM proxy.
# This is the value you use as ANTHROPIC_AUTH_TOKEN in Claude Code profiles.
# Generate a strong random key — this is the default, CHANGE IT for production.
LITELLM_MASTER_KEY=sk-change-me


# ═══════════════════════════════════════════════════════════════════════════════
# Database Password (PostgreSQL only — not needed for SQLite)
# ═══════════════════════════════════════════════════════════════════════════════
LITELLM_DB_PASSWORD=change-me


# ═══════════════════════════════════════════════════════════════════════════════
# Cloud Provider API Keys
# ═══════════════════════════════════════════════════════════════════════════════
# Set the key for each provider you want to enable.
# Leave empty (or delete the line) to disable that provider.
# Base URLs are configured in .env.

# DeepSeek — https://api.deepseek.com
DEEPSEEK_API_KEY=

# Microsoft Foundry (Azure AI) — https://tuts.services.ai.azure.com/openai/v1
MICROSOFT_FOUNDRY_API_KEY=

# NVIDIA AI Endpoints — https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=

# OpenCode Zen — https://opencode.ai/zen/v1 (free tier available)
OPENCODE_ZEN_API_KEY=


# ═══════════════════════════════════════════════════════════════════════════════
# OpenAI-Compatible Endpoint (bring your own model)
# ═══════════════════════════════════════════════════════════════════════════════
# Set to enable the OpenAI-compatible provider.
# Also set OPENAI_COMPAT_BASE_URL and OPENAI_COMPAT_MODEL in .env.
# Uncomment providers/openai-compatible.yaml in litellm/config/config.yaml.
#
# OPENAI_COMPAT_API_KEY=sk-your-key


# ═══════════════════════════════════════════════════════════════════════════════
# Anthropic-Compatible Endpoint (bring your own model)
# ═══════════════════════════════════════════════════════════════════════════════
# Set to enable the Anthropic-compatible provider.
# Also set ANTHROPIC_COMPAT_BASE_URL and ANTHROPIC_COMPAT_MODEL in .env.
# Uncomment providers/anthropic-compatible.yaml in litellm/config/config.yaml.
#
# ANTHROPIC_COMPAT_API_KEY=sk-your-key


# ═══════════════════════════════════════════════════════════════════════════════
# Local Backend API Keys
# ═══════════════════════════════════════════════════════════════════════════════
# Set to non-empty to enable the pre-configured local backends.
# Leave empty (or delete) to disable. Cloud-only users: leave both empty.
# Base URLs and model names are configured in .env.
LOCAL_M_API_KEY=
LOCAL_S_API_KEY=


# ═══════════════════════════════════════════════════════════════════════════════
# GitHub Tokens (optional)
# ═══════════════════════════════════════════════════════════════════════════════
# Used by Claude Code for GitHub integrations (PRs, issues, etc.).
GH_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=
